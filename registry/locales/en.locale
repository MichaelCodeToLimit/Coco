note The English locale. Reference binding for every core CID.
note Conditions L1 to L5 are specified in spec/04-multilingual.md section 4.3.1.

locale en
  name English
  direction left to right
  segmentation segmented
  decimal separator .
  group separator ,

note ---------------------------------------------------------------- particles

particle to           = to
particle with         = with
particle from         = from
particle into         = into
particle as           = as
particle at           = at
particle on           = on
particle by           = by
particle for          = for
particle of           = of
particle until        = until
particle in           = in
particle over         = over
particle between      = between
particle through      = through
particle and          = and
particle be           = be
particle where        = where
particle named        = named
particle spaced       = spaced
particle starting at  = starting at
particle to page      = to page
particle with style   = with style
particle described as = described as
particle says         = says

